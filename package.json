{
  "name": "gradcon-estimator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.3d.config.js",
    "build:portal": "vite build && vite build --config vite.3d.config.js && node scripts/assemble-portal.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs && node scripts/verify-estimates.mjs",
    "build:download": "node scripts/build-download.mjs",
    "verify:estimates": "node scripts/verify-estimates.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.383.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
