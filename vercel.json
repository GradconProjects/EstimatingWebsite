{
  "crons": [
    {
      "path": "/api/tender-inbox",
      "schedule": "0 20 * * *"
    }
  ],
  "functions": {
    "api/tender-inbox.js": {
      "maxDuration": 300
    },
    "api/ai-engine.js": {
      "maxDuration": 300
    },
    "api/ai-chat.js": {
      "maxDuration": 120
    },
    "api/gmail.js": {
      "maxDuration": 60
    },
    "api/drive.js": {
      "maxDuration": 60
    },
    "api/industry-news.js": {
      "maxDuration": 30
    },
    "api/notify.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/build.txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
