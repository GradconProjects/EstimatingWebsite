# Copy to .env.local (already gitignored) and fill in your Supabase
# project's values — Project Settings -> API in the Supabase dashboard.
#
# Use the anon/publishable key here — NEVER the secret/service_role key.
# The service_role key grants full admin access bypassing every row-level
# security policy and must never ship in client-side code.
#
# Leave both blank to run against localStorage instead (single-browser,
# no shared data — see README.md "Data persistence").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# AI provider keys — SERVER-SIDE ONLY. These are read by the Vercel functions
# in api/ (api/_providers.js) and must be set in the Vercel project:
# Project → Settings → Environment Variables, then redeploy. They are NOT
# prefixed with VITE_ on purpose: a VITE_ variable is bundled into the browser
# code and would be public. Leave them out of .env.local unless you are running
# `vercel dev`. Settings → "AI providers" in the portal shows which are set and
# tests each one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPEN_AI_KEY is accepted as the same variable (the spelling set in Vercel on 10 Oct 2026)
OPENAI_MODEL=gpt-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Which configured provider jobs use by default: anthropic | openai | deepseek
# (blank = the first one with a key).
AI_PROVIDER=

# --- Google Workspace mail (server-side only, read by api/_google.js) ---
# OAuth client (Web application) in the Google Cloud project; its authorised redirect URI is
# https://<your host>/api/google-auth. The consent screen is "Internal" to the gradcon.com.au
# Workspace. Scope requested: gmail.readonly. Only GOOGLE_ALLOWED_MAILBOX may connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the key the stored refresh token is encrypted with (defaults to the client secret)
GOOGLE_TOKEN_SECRET=
# Optional: the mailbox allowed to connect (default projects@gradcon.com.au)
GOOGLE_ALLOWED_MAILBOX=
